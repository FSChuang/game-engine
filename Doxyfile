# Doxygen configuration for the Game Engine API-extraction pilot (Documentation
# Phase 4). This is a MINIMAL override file, not a full Doxyfile — any setting not
# listed here uses Doxygen's own built-in default. Regenerate the full annotated
# default with `doxygen -g Doxyfile.full` if you need to see every available key.
#
# This file is read by scripts/generate_api_docs.py, which runs Doxygen as a
# subprocess and then converts its XML output into Markdown fragments embedded
# into hand-written docs/reference/*.md pages via pymdownx.snippets. See that
# script's own header comment for the full pipeline.

PROJECT_NAME           = "Game Engine"
PROJECT_BRIEF          = "C++17 / SDL3 engine — generated API facts"

# --- Input scope ---
# Documentation Phase 5: widened from the Phase 4 pilot's three headers to the
# complete public Engine API header tree. Inspected first (find Engine/src/Engine
# -name "*.h") -- all 12 headers found there are genuinely public engine API,
# nothing internal-only, so the whole tree is safe to include as-is. FILE_PATTERNS
# restricts this to headers only; .cpp implementation files are never parsed.
INPUT                  = Engine/src/Engine
RECURSIVE              = YES
FILE_PATTERNS          = *.h

# --- Extraction ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES

# --- Output: XML only, no HTML/LaTeX site of our own ---
OUTPUT_DIRECTORY       = .docs-build
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = doxygen-xml
XML_PROGRAMLISTING     = NO

# --- Warnings ---
# WARN_IF_UNDOCUMENTED: re-enabled in Documentation Phase 5, now that INPUT
# covers the complete public Engine API header tree (widened above) and every
# header in it has a /// pass. Verified empirically before flipping this on:
# ran a diagnostic build of the full widened INPUT with this setting enabled
# and got zero warnings -- EXTRACT_ALL=YES means a documented class/enum/struct
# whose individual trivial members (e.g. a plain getter) have no /// comment of
# their own doesn't trigger this warning, so there's no meaningless noise from
# "every trivial data member needs an essay" -- only genuine gaps would surface.
# WARN_NO_PARAMDOC stays off: most comments here are plain prose, not per-@param
# tagged, and that's a deliberate style choice (see scripts/generate_api_docs.py's
# @param-bullet handling), not a documentation gap worth warning about.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# --- Keep this lean and portable ---
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST = NO
SOURCE_BROWSER         = NO
