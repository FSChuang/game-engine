# Doxygen configuration for the Game Engine API-extraction pilot (Documentation
# Phase 4). This is a MINIMAL override file, not a full Doxyfile — any setting not
# listed here uses Doxygen's own built-in default. Regenerate the full annotated
# default with `doxygen -g Doxyfile.full` if you need to see every available key.
#
# This file is read by scripts/generate_api_docs.py, which runs Doxygen as a
# subprocess and then converts its XML output into Markdown fragments embedded
# into hand-written docs/reference/*.md pages via pymdownx.snippets. See that
# script's own header comment for the full pipeline.

PROJECT_NAME           = "Game Engine"
PROJECT_BRIEF          = "C++17 / SDL3 engine — generated API facts"

# --- Input scope ---
# Pilot phase (Documentation Phase 4): only the three headers being piloted.
# Widen this to "Engine/src/Engine" (recursive) once more headers are migrated
# to /// comments in a future phase — nothing else about this file needs to
# change to scale up.
INPUT                  = Engine/src/Engine/Time/Timeline.h \
                          Engine/src/Engine/Renderer/Renderer.h \
                          Engine/src/Engine/Network/Socket.h
RECURSIVE              = NO
FILE_PATTERNS          = *.h

# --- Extraction ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES

# --- Output: XML only, no HTML/LaTeX site of our own ---
OUTPUT_DIRECTORY       = .docs-build
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = doxygen-xml
XML_PROGRAMLISTING     = NO

# --- Warnings ---
# WARN_IF_UNDOCUMENTED is off pre-emptively, not because it's currently noisy:
# with INPUT scoped to just the pilot's three headers (all fully documented),
# it produces zero warnings today (verified). It's off because the INPUT
# comment above describes widening to the whole Engine/src/Engine tree in a
# future phase, at which point enabling this would flood output with warnings
# for every not-yet-migrated header — noise, not signal, until those headers
# get their own /// pass. Re-enable once that widening happens and the rest of
# the engine has been migrated.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# --- Keep this lean and portable ---
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST = NO
SOURCE_BROWSER         = NO
